# =============================================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy to .env and fill in your actual credentials.
# NEVER commit your real .env file with secrets to Git!
# =============================================================================

PORT=5000
NODE_ENV=production

# Database Connection
DATABASE_URL=

# Optional individual DB parameters if not using DATABASE_URL:
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=

# Supabase API (if applicable)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

CORS_ORIGIN=
