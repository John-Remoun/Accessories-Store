PORT=5000
NODE_ENV=production

# Supabase Database URL (Replace [YOUR-PASSWORD] with Supabase database password)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jhkcmyckrylfmdhiffje.supabase.co:5432/postgres

# Individual Connection Parameters
DB_HOST=db.jhkcmyckrylfmdhiffje.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_DATABASE=postgres
DB_SSL=true

# Supabase Keys
SUPABASE_URL=https://jhkcmyckrylfmdhiffje.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
